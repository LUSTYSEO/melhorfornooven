---
/**
 * index.astro — Página inicial
 *
 * Renderiza condicionalmente:
 *   siteMode === 'local' → LocalHome (modo rank-and-rent)
 *   siteMode === 'blog'  → ClassicHome
 */
import { getCollection, getEntry } from 'astro:content';
import { readSingleton } from '../utils/singleton-utils';
import ClassicHome from '../themes/classic/Home.astro';
import LocalHome   from '../themes/local/Home.astro';

const settings = await getEntry('siteSettings', 'settings').catch(() => null);
const siteMode = (settings?.data?.siteMode || 'blog') as 'blog' | 'local';

const localData = siteMode === 'local'
    ? await readSingleton('home', 'local') || {}
    : null;

const home = siteMode !== 'local'
    ? await readSingleton('home', 'classic') || {}
    : null;

// Posts pilares comerciais exibidos na Home na ordem estratégica
const featuredSlugs = [
    'melhor-air-fryer-oven',
    'air-fryer-12l-qual-a-melhor',
    'melhor-air-fryer-oven-espeto-giratorio',
];

const allPosts = siteMode !== 'local' ? await getCollection('posts') : [];

const latestPosts = siteMode !== 'local'
    ? featuredSlugs
        .map(slug => allPosts.find((p: any) => (p.data.slug === slug || p.id === slug || p.id === `${slug}.mdoc` || p.id === `${slug}.md`)))
        .filter(Boolean)
    : [];

const blogPermalinkStructure = (settings?.data?.blogPermalinkStructure as import('../utils/blog-permalink').BlogPermalinkStructure) || 'postname';
const blogUrlPrefix = (settings?.data?.blogUrlPrefix as import('../utils/blog-permalink').BlogUrlPrefix) || 'blog';
---

{siteMode === 'local'
    ? <LocalHome homeData={localData} />
    : <ClassicHome homeData={home} themeId="classic" latestPosts={latestPosts} blogPermalinkStructure={blogPermalinkStructure} blogUrlPrefix={blogUrlPrefix} />
}
