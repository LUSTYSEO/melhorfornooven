---
/**
 * Footer.astro (Classic Theme)
 * 
 * Componente de rodapé do tema Classic.
 * Lê os dados do singleton 'footer' para renderizar o rodapé dinamicamente.
 */

import { getEntry } from 'astro:content';
import { readSingleton } from '../../../utils/singleton-utils';

const { activeThemeId } = Astro.props;
const year = new Date().getFullYear();

// Carregar dados do rodapé do singleton do tema ativo
const footerData  = await readSingleton('footer', activeThemeId);
const siteSettings = await getEntry('siteSettings', 'settings').catch(() => null);
const fallbackName = siteSettings?.data?.siteName || 'Meu Site';

const siteName    = footerData?.siteName    || fallbackName;
const copyright   = footerData?.copyright   || `© ${year} ${fallbackName}. Todos os direitos reservados.`;
const description = footerData?.description || 'Transformando ideias em interfaces de alto impacto com Astro, Keystatic e Inteligência Artificial.';
const columns     = footerData?.columns     || [];
const socialLinks = footerData?.socialLinks || [];
---

<footer class="bg-[#0a0a0a] border-t border-white/10 py-16 md:py-20 px-6">
    <div class="container mx-auto">
        <div class="grid md:grid-cols-4 gap-12 mb-16">
            <div class="col-span-2">
                <div class="text-2xl font-heading font-black text-white mb-4">{siteName}</div>
                <p class="text-slate-100 text-sm sm:text-base max-w-sm leading-relaxed font-normal">{description}</p>
            </div>
            {columns.map((column: any) => (
                <div>
                    <h4 class="text-white font-bold mb-6 uppercase tracking-widest text-xs sm:text-sm">{column.title}</h4>
                    <ul class="space-y-3 text-sm">
                        {(column.links || []).map((link: any) => (
                            <li>
                                <a href={link.href} class="text-slate-100 hover:text-white transition-colors block py-0.5">{link.label}</a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
        <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-100 font-medium whitespace-nowrap overflow-hidden">
            <p>{copyright}</p>
            <div class="flex gap-6 uppercase tracking-widest items-center">
                {socialLinks.length > 0 && (
                    <div class="flex gap-4">
                        {socialLinks.map((social: any) => (
                            <a 
                                href={social.url} 
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-slate-100 hover:text-white transition-colors"
                                title={social.platform}
                            >
                                {social.icon || social.platform}
                            </a>
                        ))}
                    </div>
                )}
                <span class="text-slate-200">Classic Theme v1.0</span>
            </div>
        </div>
    </div>
</footer>
